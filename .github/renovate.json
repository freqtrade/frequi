{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "local>freqtrade/renovate-config"
  ],
  "timezone": "Europe/Berlin",
  "schedule": [
    "* 0-5 * * 3"
  ],
  "lockFileMaintenance": {
    "schedule": [
      "* 0-5 * * 4"
    ]
  },
  "packageRules": [
    {
      "description": "Breaking changes without a major release",
      "matchPackageNames": [
        "@noction/vue-draggable-grid"
      ],
      "enabled": false
    }
  ]
}
